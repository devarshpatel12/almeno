# PostgreSQL settings
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# SQLAlchemy connection for the API and worker
DATABASE_URL=postgresql+psycopg2://app:secret@postgres:5432/appdb

# Redis broker for Celery
REDIS_URL=redis://redis:6379/0

# Optional LLM API key for category classification
GEMINI_API_KEY=

# Maximum upload size in bytes (5 MB)
UPLOAD_MAX_SIZE=5242880
